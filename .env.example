# Postgres. Railway's Postgres plugin injects this for you on the web service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoerack?schema=public"

# openssl rand -base64 32
AUTH_SECRET=""

# The full public origin, no trailing slash. Locally: http://localhost:3000
AUTH_URL="http://localhost:3000"
# Railway terminates TLS in front of the app, so the host header has to be trusted.
AUTH_TRUST_HOST="true"

# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Both must be set or the Apple button hides itself.
# AUTH_APPLE_ID is the Services ID; AUTH_APPLE_SECRET is the signed JWT minted
# from your .p8 key, Team ID and Key ID.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Shared secret for POST /api/cron/refresh-prices.
CRON_SECRET=""

# Sending confirmation emails. Set ONE of these.
#
# SMTP_URL delivers to any recipient with no domain to own, which is what open
# registration needs. A Gmail app password works:
#   SMTP_URL="smtp://you%40gmail.com:app-password@smtp.gmail.com:587"
#
# RESEND_API_KEY needs no install, but on Resend's shared onboarding@resend.dev
# sender it only delivers to your own address — you need a verified domain
# before it will mail strangers.
#
# With neither set, the link is written to the server log instead of being
# sent, so local development works without credentials.
# SMTP_URL=""
# RESEND_API_KEY=""
# MAIL_FROM="Shoe Rack <onboarding@resend.dev>"

# Optional. Set it and the price row shows real numbers instead of search links.
# SERPAPI_KEY=""
