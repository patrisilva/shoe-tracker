# Postgres. Railway's Postgres plugin injects this for you on the web service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoerack?schema=public"

# openssl rand -base64 32
AUTH_SECRET=""

# The full public origin, no trailing slash. Locally: http://localhost:3000
AUTH_URL="http://localhost:3000"
# Railway terminates TLS in front of the app, so the host header has to be trusted.
AUTH_TRUST_HOST="true"

# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Both must be set or the Apple button hides itself.
# AUTH_APPLE_ID is the Services ID; AUTH_APPLE_SECRET is the signed JWT minted
# from your .p8 key, Team ID and Key ID.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Shared secret for POST /api/cron/refresh-prices.
CRON_SECRET=""

# Sending confirmation emails. Set ONE; tried in this order.
#
# Railway blocks outbound SMTP on every port, so SMTP_URL cannot work there
# however valid the credentials. Both API options go over HTTPS.
#
# BREVO_API_KEY: verify a single sender address — a plain Gmail is fine — with
# no domain to own. The option that suits open registration.
# BREVO_API_KEY=""
#
# RESEND_API_KEY: mailing arbitrary recipients needs a verified domain; the
# shared onboarding@resend.dev sender only reaches your own address.
# RESEND_API_KEY=""
#
# SMTP_URL: only where outbound SMTP is allowed, or a local sink in dev.
#   SMTP_URL="smtp://you%40gmail.com:apppassword@smtp.gmail.com:587"
# SMTP_URL=""
#
# The From. Defaults to the SMTP username when that is set.
# MAIL_FROM="Shoe Rack <shoeruntracker@gmail.com>"

# Optional. Set it and the price row shows real numbers instead of search links.
# SERPAPI_KEY=""
