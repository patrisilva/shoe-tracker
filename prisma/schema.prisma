generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Set only for accounts created with email and password. Null for OAuth
  // users, which is what stops a Google-only account being password-guessed.
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  shoes         Shoe[]
  runs          Run[]
  // Distances are stored in whichever unit the account is set to. Changing it
  // converts the existing rows, so stored numbers always match this value.
  unit          DistanceUnit @default(MI)
  createdAt     DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Shoe rack ----------

enum DistanceUnit {
  MI
  KM
}

model Shoe {
  id               String    @id @default(cuid())
  userId           String
  brand            String
  model            String
  nickname         String?
  // Distance already on the shoe when it was added, in the account's unit.
  startingDistance Float     @default(0)
  // Retirement threshold, in the account's unit. 400 mi / 800 km are the
  // common rules of thumb; the default here is the miles one.
  lifespanDistance Float     @default(400)
  purchasedOn      DateTime?
  retiredAt        DateTime?
  createdAt        DateTime  @default(now())
  // When the review sites were last searched for this shoe. Null means never,
  // which is what triggers the first lookup — shoes added before the finder
  // existed backfill themselves on their next visit.
  reviewsCheckedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs     Run[]
  links    ShoeLink[]
  prices   PriceSnapshot[]
  image    ShoeImage?

  @@index([userId, retiredAt])
}

/**
 * A user's own photo of the pair, held in its own table so that listing the
 * rack never drags image bytes along with it. The browser downscales before
 * upload, so rows are tens of kilobytes rather than megabytes.
 */
model ShoeImage {
  shoeId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  shoe Shoe @relation(fields: [shoeId], references: [id], onDelete: Cascade)
}

model Run {
  id        String   @id @default(cuid())
  shoeId    String
  userId    String
  // In the account's unit, same as Shoe.startingDistance.
  distance  Float
  ranOn     DateTime
  notes     String?
  createdAt DateTime @default(now())

  shoe Shoe @relation(fields: [shoeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shoeId, ranOn])
  @@index([userId, ranOn])
}

enum LinkKind {
  REVIEW
  RETAILER
}

model ShoeLink {
  id       String   @id @default(cuid())
  shoeId   String
  kind     LinkKind
  title    String
  source   String
  url      String   @db.Text
  position Int      @default(0)

  // Filled in when a real article is matched for this shoe. Null while the
  // link is still only a deep link into the site's own search, which is what
  // a freshly created shoe starts with.
  imageUrl  String?   @db.Text
  excerpt   String?   @db.Text
  publishedAt DateTime?

  shoe Shoe @relation(fields: [shoeId], references: [id], onDelete: Cascade)

  @@index([shoeId, kind, position])
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  shoeId     String
  retailer   String
  url        String   @db.Text
  // Null when the provider only returns a link and not a parsed number.
  priceCents Int?
  currency   String   @default("USD")
  checkedAt  DateTime @default(now())

  shoe Shoe @relation(fields: [shoeId], references: [id], onDelete: Cascade)

  @@index([shoeId, checkedAt])
}
